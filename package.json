{
  "name": "summon-fixer",
  "version": "0.1.0",
  "private": true,
  "description": "Project-local Codex-powered development companion",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "npm run --workspaces --if-present test",
    "clean": "npm run --workspaces --if-present clean"
  },
  "devDependencies": {
    "@types/node": "^24.13.0",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  }
}
