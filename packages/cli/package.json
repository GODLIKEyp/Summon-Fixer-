{
  "name": "@summon-fixer/cli",
  "version": "0.1.0",
  "description": "Project-local CLI for Summon Fixer",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "summon": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@summon-fixer/contracts": "*",
    "@summon-fixer/runner": "*"
  },
  "devDependencies": {
    "@summon-fixer/overlay": "*",
    "@summon-fixer/vite-plugin": "*",
    "@types/node": "^24.13.0",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  }
}
