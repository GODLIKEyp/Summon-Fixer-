{
  "name": "@summon-fixer/overlay",
  "version": "0.1.0",
  "description": "Client-side development overlay for Summon Fixer",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@summon-fixer/contracts": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.0",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  }
}
